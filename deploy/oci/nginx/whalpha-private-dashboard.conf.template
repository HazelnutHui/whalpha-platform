# Template only. Do not install without deployment review.
# Root is the unauthenticated branded credential/guest entry.
# Dashboard and JSON snapshots share the same role-free server-side Session boundary.

limit_req_zone $binary_remote_addr zone=whalpha_login:10m rate=5r/m;

server {
    listen 80;
    listen [::]:80;
    server_name whalpha.com www.whalpha.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name whalpha.com www.whalpha.com;

    ssl_certificate /etc/letsencrypt/live/whalpha.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/whalpha.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    if ($request_uri ~* "%2e") {
        return 400;
    }

    location = / {
        root /srv/whalpha/current;
        add_header Cache-Control "private, no-store" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
        try_files /login/index.html =404;
    }

    location = /favicon.png {
        root /srv/whalpha/current;
        add_header Cache-Control "public, max-age=86400" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files /favicon.png =404;
    }

    location / {
        return 404;
    }

    location ~ /\. {
        deny all;
    }

    location ~* %2e {
        return 400;
    }

    location = /login {
        return 302 /;
    }

    location = /login/ {
        return 302 /$is_args$args;
    }

    location /login/ {
        root /srv/whalpha/current;
        index index.html;
        autoindex off;
        add_header Cache-Control "private, no-store" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
        try_files $uri $uri/ =404;
    }

    location = /auth/login {
        limit_req zone=whalpha_login burst=3 nodelay;
        proxy_pass http://127.0.0.1:8010/login;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /auth/guest {
        limit_req zone=whalpha_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8010/guest;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /auth/logout {
        proxy_pass http://127.0.0.1:8010/logout;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /auth/visit {
        if ($request_method != POST) {
            return 405;
        }
        proxy_pass http://127.0.0.1:8010/visit;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /auth/status {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }
        proxy_pass http://127.0.0.1:8010/status;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /auth/internal-verify {
        internal;
        proxy_pass http://127.0.0.1:8010/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_set_header X-Original-URI $request_uri;
    }

    location @dashboard_login_redirect {
        return 302 /?next=$request_uri;
    }

    location @private_data_unauthorized {
        default_type application/json;
        add_header Cache-Control "private, no-store" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
        return 401 '{"status":"unauthorized"}';
    }

    location = /dashboard {
        auth_request /auth/internal-verify;
        error_page 401 = @dashboard_login_redirect;
        return 301 /dashboard/;
    }

    location /dashboard/ {
        auth_request /auth/internal-verify;
        error_page 401 = @dashboard_login_redirect;
        alias /srv/whalpha/current/dashboard/;
        index index.html;
        autoindex off;
        add_header Cache-Control "private, no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
        try_files $uri $uri/ /dashboard/index.html;
    }

    location /dashboard/assets/ {
        auth_request /auth/internal-verify;
        error_page 401 = @dashboard_login_redirect;
        alias /srv/whalpha/current/dashboard/assets/;
        autoindex off;
        add_header Cache-Control "private, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
        try_files $uri =404;
    }

    location = /private-data {
        auth_request /auth/internal-verify;
        error_page 401 = @private_data_unauthorized;
        return 401;
    }

    location /private-data/ {
        auth_request /auth/internal-verify;
        error_page 401 = @private_data_unauthorized;
        alias /srv/whalpha/current/private-data/;
        autoindex off;
        default_type application/json;
        types { application/json json; }
        add_header Cache-Control "private, no-store" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
        try_files $uri =404;
    }

    location = /deployment-manifest.json {
        return 404;
    }

    location = /checksums.sha256 {
        return 404;
    }
}
